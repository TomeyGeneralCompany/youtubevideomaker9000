# Use a new workspace, separate from the live Paul Revere installation.
TUBE_WORKSPACE=/absolute/path/to/new-workspace
# Reuse your installed Qwen runtime and model directory by explicitly selecting it.
VOICE_ENGINE_DIR=/absolute/path/to/installed-voice-engine
# Profile paths default to the selected workspace.
# VOICE_PROFILE=/absolute/path/to/voice-profile.json
# MEDIA_PROFILE=/absolute/path/to/media-profile.json
AGENT_LANGUAGE=English
